// TELEFON.UZB — единая база данных для публичного сайта и админ-панели.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  /// Increment to invalidate all existing sessions of the user (logout everywhere / password change).
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  /// TOTP secret (base32). Set while 2FA is being set up; 2FA is active once totpEnabledAt is set.
  totpSecret    String?
  totpEnabledAt DateTime?
  /// last accepted 30-second step — a code cannot be used twice
  totpLastStep  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameRu    String
  nameUz    String    @default("")
  sortOrder Int       @default(0)
  isVisible Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  isVisible Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  nameRu        String
  nameUz        String         @default("")
  descriptionRu String         @default("")
  descriptionUz String         @default("")
  /// Цена в валюте currency (сумы или доллары)
  price         Int
  /// "UZS" | "USD"
  currency      String         @default("UZS")
  /// "new" | "used"
  condition     String         @default("new")
  /// Б/у: ёмкость аккумулятора, %, и число циклов
  batteryHealth Int?
  batteryCycles Int?
  /// Б/у: есть ли коробка (null — не указано)
  hasBox        Boolean?
  /// Б/у: регион / модель, например "AF/A (SIM + eSIM)"
  region        String         @default("")
  conditionNoteRu String       @default("")
  conditionNoteUz String       @default("")
  /// Рассрочка именно для этого аппарата: [{ down, months, monthly }] в валюте currency
  installmentOffers Json       @default("[]")
  inStock       Boolean        @default(true)
  isHidden      Boolean        @default(false)
  isFeatured    Boolean        @default(false)
  sortOrder     Int            @default(0)
  /// Варианты памяти, например ["256 GB", "512 GB"]
  storageOptions String[]      @default([])
  /// Цена по объёму памяти: { "256 GB": 12500000 }; не указана — используется price
  storagePrices Json           @default("{}")
  /// [{ nameRu, nameUz, hex }]
  colors        Json           @default("[]")
  /// [{ labelRu, labelUz, valueRu, valueUz }]
  specs         Json           @default("[]")
  /// Параметры процедурной 3D-модели, если GLB не загружен: { kind, layout, frame, body? }
  model3d       Json           @default("{}")
  modelAssetId  String?
  modelAsset    Asset?         @relation("ProductModel", fields: [modelAssetId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  brandId       String
  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isHidden, categoryId])
  @@index([brandId])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)
  /// HEX of the product colour this photo shows (null = all colours)
  colorKey  String?
  /// "studio" — product on a white background (shown whole); "photo" — live shot (fills the frame)
  style     String  @default("studio")

  @@index([productId, sortOrder])
}

/// Загруженный файл (фото, 3D-модель, видео, логотип). Содержимое хранится
/// в PostgreSQL (driver = "db") или в S3-совместимом хранилище (driver = "s3").
model Asset {
  id            String         @id @default(cuid())
  filename      String
  mimeType      String
  size          Int
  driver        String         @default("db")
  data          Bytes?
  storageKey    String?
  width         Int?
  height        Int?
  createdAt     DateTime       @default(now())
  productImages ProductImage[]
  productModels Product[]      @relation("ProductModel")
}

/// Настройки сайта: контакты, тексты главной, видео, логотип, баннеры.
model SiteSettings {
  id        Int      @id @default(1)
  content   Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  summary   String
  actor     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
