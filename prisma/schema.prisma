// TELEFON.UZB — единая база данных для публичного сайта и админ-панели.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  /// Increment to invalidate all existing sessions of the user (logout everywhere / password change).
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameRu    String
  nameUz    String    @default("")
  sortOrder Int       @default(0)
  isVisible Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  isVisible Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  nameRu        String
  nameUz        String         @default("")
  descriptionRu String         @default("")
  descriptionUz String         @default("")
  /// Цена в сумах (UZS)
  price         Int
  /// Специальная (акционная) цена в сумах
  specialPrice  Int?
  inStock       Boolean        @default(true)
  isHidden      Boolean        @default(false)
  isFeatured    Boolean        @default(false)
  sortOrder     Int            @default(0)
  /// Варианты памяти, например ["256 GB", "512 GB"]
  storageOptions String[]      @default([])
  /// [{ nameRu, nameUz, hex }]
  colors        Json           @default("[]")
  /// [{ labelRu, labelUz, valueRu, valueUz }]
  specs         Json           @default("[]")
  /// Параметры процедурной 3D-модели, если GLB не загружен: { kind, layout, frame, body? }
  model3d       Json           @default("{}")
  modelAssetId  String?
  modelAsset    Asset?         @relation("ProductModel", fields: [modelAssetId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  brandId       String
  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isHidden, categoryId])
  @@index([brandId])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

/// Загруженный файл (фото, 3D-модель, видео, логотип). Содержимое хранится
/// в PostgreSQL (driver = "db") или в S3-совместимом хранилище (driver = "s3").
model Asset {
  id            String         @id @default(cuid())
  filename      String
  mimeType      String
  size          Int
  driver        String         @default("db")
  data          Bytes?
  storageKey    String?
  width         Int?
  height        Int?
  createdAt     DateTime       @default(now())
  productImages ProductImage[]
  productModels Product[]      @relation("ProductModel")
}

/// Настройки сайта: контакты, тексты главной, видео, логотип, баннеры.
model SiteSettings {
  id        Int      @id @default(1)
  content   Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  summary   String
  actor     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
