# PostgreSQL connection string
DATABASE_URL="postgresql://telefon:telefon@localhost:5432/telefonuzb?schema=public"

# Secret for signing admin session tokens (min 32 random chars): openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Initial administrator (used only by `npm run db:seed` / `npm run admin:create` when creating the account)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong-password"

# Public site URL (used for canonical / hreflang / sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# File storage for uploads: "db" (default — files stored in PostgreSQL, included in DB backups) or "s3"
STORAGE_DRIVER="db"
# Required only for STORAGE_DRIVER="s3" (any S3-compatible service: AWS S3, Cloudflare R2, MinIO...)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
